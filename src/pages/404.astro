---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Lost in Space" description="This page doesn't exist.">
  <div id="not-found">
    <canvas id="galaxy-canvas"></canvas>

    <div class="nf-content" id="nf-content">
      <p class="nf-label">You're lost in space</p>
      <p class="nf-sub">The page you're looking for doesn't exist or was moved.</p>
      <a href="/" class="btn-primary">← Return home</a>
    </div>
  </div>
</BaseLayout>

<style>
  #not-found {
    position: fixed;
    inset: 0;
    background: #020614;
    overflow: hidden;
  }

  #galaxy-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .nf-content {
    position: absolute;
    bottom: 12%;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    opacity: 0;
    animation: fadeUp 1s ease 1.2s forwards;
  }

  .nf-label {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    background: linear-gradient(90deg, #0693e3, #22d3ee);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nf-sub {
    font-size: 1.6rem;
    color: var(--color-text-muted);
    max-width: 36rem;
    line-height: 1.6;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateX(-50%) translateY(16px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  @media (max-width: 600px) {
    .nf-content { bottom: 8%; }
    .nf-label   { font-size: 1.1rem; }
    .nf-sub     { font-size: 1.4rem; }
  }
</style>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('not-found') as HTMLDivElement;
  const canvas    = document.getElementById('galaxy-canvas') as HTMLCanvasElement;

  let W = container.clientWidth;
  let H = container.clientHeight;

  // ─── Renderer ─────────────────────────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setSize(W, H);
  renderer.setClearColor(0x020614, 1);

  const scene  = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, W / H, 0.1, 2000);
  camera.position.z = 100;

  // ─── Helpers ──────────────────────────────────────────────────────────────
  function makePoints(
    geo: THREE.BufferGeometry,
    vs: string,
    fs: string,
    uniforms: Record<string, THREE.IUniform> = {},
    vertexColors = false,
  ) {
    return new THREE.Points(
      geo,
      new THREE.ShaderMaterial({
        uniforms,
        vertexShader: vs,
        fragmentShader: fs,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexColors,
      }),
    );
  }

  // ─── 1. Background stars ───────────────────────────────────────────────────
  const STAR_COUNT = 9000;
  const sPos  = new Float32Array(STAR_COUNT * 3);
  const sSiz  = new Float32Array(STAR_COUNT);
  const sCol  = new Float32Array(STAR_COUNT * 3);
  const sTwink = new Float32Array(STAR_COUNT);

  for (let i = 0; i < STAR_COUNT; i++) {
    sPos[i*3]   = (Math.random() - 0.5) * 700;
    sPos[i*3+1] = (Math.random() - 0.5) * 500;
    sPos[i*3+2] = -50 - Math.random() * 300;
    sSiz[i]     = Math.random() * 2.2 + 0.3;
    sTwink[i]   = Math.random() * Math.PI * 2;

    const t = Math.random();
    if (t < 0.65) {
      sCol[i*3] = 0.75 + Math.random()*0.25;
      sCol[i*3+1] = 0.85 + Math.random()*0.15;
      sCol[i*3+2] = 1.0;
    } else if (t < 0.82) {
      sCol[i*3] = 0.4; sCol[i*3+1] = 0.7; sCol[i*3+2] = 1.0;
    } else {
      sCol[i*3] = 1.0; sCol[i*3+1] = 0.95; sCol[i*3+2] = 0.75;
    }
  }

  const starGeo = new THREE.BufferGeometry();
  starGeo.setAttribute('position', new THREE.BufferAttribute(sPos,  3));
  starGeo.setAttribute('aSize',    new THREE.BufferAttribute(sSiz,  1));
  starGeo.setAttribute('color',    new THREE.BufferAttribute(sCol,  3));
  starGeo.setAttribute('aTwink',   new THREE.BufferAttribute(sTwink,1));

  const starUniforms = { uTime: { value: 0 } };
  const stars = makePoints(
    starGeo,
    /* vertex */ `
      attribute float aSize;
      attribute float aTwink;
      attribute vec3  color;
      varying   vec3  vColor;
      varying   float vAlpha;
      uniform   float uTime;
      void main() {
        vColor = color;
        vAlpha = 0.6 + 0.4 * sin(uTime * 1.2 + aTwink);
        vec4 mv = modelViewMatrix * vec4(position, 1.0);
        gl_PointSize = aSize * (220.0 / -mv.z);
        gl_Position  = projectionMatrix * mv;
      }
    `,
    /* fragment */ `
      varying vec3  vColor;
      varying float vAlpha;
      void main() {
        vec2  uv = gl_PointCoord - 0.5;
        float d  = length(uv);
        if (d > 0.5) discard;
        float a = pow(1.0 - smoothstep(0.0, 0.5, d), 1.8) * vAlpha;
        gl_FragColor = vec4(vColor, a);
      }
    `,
    starUniforms,
    true,
  );
  scene.add(stars);

  // ─── 2. Nebula / galaxy blobs ─────────────────────────────────────────────
  const NEB_COUNT = 400;
  const nPos = new Float32Array(NEB_COUNT * 3);
  const nCol = new Float32Array(NEB_COUNT * 3);
  const nSiz = new Float32Array(NEB_COUNT);

  for (let i = 0; i < NEB_COUNT; i++) {
    const arm    = Math.floor(Math.random() * 3);
    const angle  = (arm * Math.PI * 2) / 3 + Math.random() * 1.2;
    const radius = 25 + Math.random() * 90;
    nPos[i*3]   = Math.cos(angle) * radius * 1.8 + (Math.random()-0.5)*20;
    nPos[i*3+1] = Math.sin(angle) * radius * 0.7 + (Math.random()-0.5)*15;
    nPos[i*3+2] = -30 - Math.random() * 40;
    nSiz[i]     = 25 + Math.random() * 55;

    const t = Math.random();
    if (t < 0.45) {
      nCol[i*3] = 0.02; nCol[i*3+1] = 0.18; nCol[i*3+2] = 0.9;
    } else if (t < 0.75) {
      nCol[i*3] = 0.25; nCol[i*3+1] = 0.04; nCol[i*3+2] = 0.7;
    } else {
      nCol[i*3] = 0.04; nCol[i*3+1] = 0.55; nCol[i*3+2] = 0.8;
    }
  }

  const nebGeo = new THREE.BufferGeometry();
  nebGeo.setAttribute('position', new THREE.BufferAttribute(nPos, 3));
  nebGeo.setAttribute('color',    new THREE.BufferAttribute(nCol, 3));
  nebGeo.setAttribute('aSize',    new THREE.BufferAttribute(nSiz, 1));

  const nebula = makePoints(
    nebGeo,
    `attribute float aSize; attribute vec3 color; varying vec3 vColor;
     void main() {
       vColor = color;
       vec4 mv = modelViewMatrix * vec4(position,1.0);
       gl_PointSize = aSize * (220.0 / -mv.z);
       gl_Position  = projectionMatrix * mv;
     }`,
    `varying vec3 vColor;
     void main() {
       vec2 uv = gl_PointCoord - 0.5;
       float d = length(uv);
       if (d > 0.5) discard;
       float a = pow(1.0 - smoothstep(0.0, 0.5, d), 4.0) * 0.28;
       gl_FragColor = vec4(vColor, a);
     }`,
    {},
    true,
  );
  scene.add(nebula);

  // ─── 3. "404" particle text ────────────────────────────────────────────────
  function build404Particles() {
    const OW = 1200, OH = 340;
    const off = document.createElement('canvas');
    off.width  = OW;
    off.height = OH;
    const ctx  = off.getContext('2d')!;

    // Heavier font sampling for dense look
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 290px Arial Black, Arial, sans-serif';
    ctx.textAlign    = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('404', OW / 2, OH / 2);

    const { data } = ctx.getImageData(0, 0, OW, OH);
    const pts: number[] = [];
    const step = 5;

    for (let y = 0; y < OH; y += step) {
      for (let x = 0; x < OW; x += step) {
        const i = (y * OW + x) * 4;
        if (data[i + 3] > 100) {
          // add jitter so it looks like scattered stars, not a grid
          const jx = (Math.random() - 0.5) * step * 0.8;
          const jy = (Math.random() - 0.5) * step * 0.8;
          const wx  =  ((x + jx) / OW - 0.5) * 92;
          const wy  = -((y + jy) / OH - 0.5) * 26;
          const wz  =  (Math.random() - 0.5) * 3;
          pts.push(wx, wy, wz);
        }
      }
    }
    return pts;
  }

  const rawPts   = build404Particles();
  const pCount   = rawPts.length / 3;
  const pPos     = new Float32Array(rawPts);
  const pSize    = new Float32Array(pCount);
  const pOffset  = new Float32Array(pCount);
  const pBright  = new Float32Array(pCount);

  for (let i = 0; i < pCount; i++) {
    pSize[i]   = Math.random() * 3.2 + 0.6;
    pOffset[i] = Math.random() * Math.PI * 2;
    pBright[i] = 0.45 + Math.random() * 0.55;
  }

  const geo404 = new THREE.BufferGeometry();
  geo404.setAttribute('position', new THREE.BufferAttribute(pPos,    3));
  geo404.setAttribute('aSize',    new THREE.BufferAttribute(pSize,   1));
  geo404.setAttribute('aOffset',  new THREE.BufferAttribute(pOffset, 1));
  geo404.setAttribute('aBright',  new THREE.BufferAttribute(pBright, 1));

  const u404 = { uTime: { value: 0 } };
  const pts404 = makePoints(
    geo404,
    /* vertex */ `
      attribute float aSize;
      attribute float aOffset;
      attribute float aBright;
      varying   float vBright;
      varying   float vCore;
      uniform   float uTime;
      void main() {
        float twinkle = 0.65 + 0.35 * sin(uTime * 2.5 + aOffset);
        vBright = aBright * twinkle;
        vCore   = step(0.75, aBright);                    // brighter = star core
        float drift = sin(uTime * 0.4 + aOffset) * 0.25;
        vec3 pos = position + vec3(
          cos(aOffset * 1.3) * drift * 0.4,
          sin(aOffset * 0.9) * drift * 0.3,
          0.0
        );
        vec4 mv = modelViewMatrix * vec4(pos, 1.0);
        float pulse = 1.0 + 0.12 * sin(uTime * 4.0 + aOffset);
        gl_PointSize = aSize * pulse * (320.0 / -mv.z);
        gl_Position  = projectionMatrix * mv;
      }
    `,
    /* fragment */ `
      varying float vBright;
      varying float vCore;
      void main() {
        vec2  uv = gl_PointCoord - 0.5;
        float d  = length(uv);
        if (d > 0.5) discard;
        float glow = 1.0 - smoothstep(0.0, 0.5, d);
        float core = 1.0 - smoothstep(0.0, 0.18, d);
        float a    = glow * 0.55 + core * 0.9;
        // core colour: near-white cyan; outer glow: deeper blue
        vec3 outerColor = vec3(0.15, 0.55, 1.0);
        vec3 innerColor = vec3(0.85, 0.97, 1.0);
        vec3 col = mix(outerColor, innerColor, core);
        // occasional very bright stars
        col = mix(col, vec3(1.0), vCore * core * 0.6);
        gl_FragColor = vec4(col, a * vBright);
      }
    `,
    u404,
  );
  scene.add(pts404);

  // ─── 4. Sparse bright foreground dust ─────────────────────────────────────
  const DUST_COUNT = 120;
  const dPos = new Float32Array(DUST_COUNT * 3);
  const dSiz = new Float32Array(DUST_COUNT);
  const dOff = new Float32Array(DUST_COUNT);

  for (let i = 0; i < DUST_COUNT; i++) {
    dPos[i*3]   = (Math.random() - 0.5) * 180;
    dPos[i*3+1] = (Math.random() - 0.5) * 90;
    dPos[i*3+2] = (Math.random() - 0.5) * 20 + 10;
    dSiz[i]     = Math.random() * 2.5 + 1.0;
    dOff[i]     = Math.random() * Math.PI * 2;
  }

  const dustGeo = new THREE.BufferGeometry();
  dustGeo.setAttribute('position', new THREE.BufferAttribute(dPos, 3));
  dustGeo.setAttribute('aSize',    new THREE.BufferAttribute(dSiz, 1));
  dustGeo.setAttribute('aOffset',  new THREE.BufferAttribute(dOff, 1));

  const uDust = { uTime: { value: 0 } };
  const dust = makePoints(
    dustGeo,
    `attribute float aSize; attribute float aOffset;
     varying float vA;
     uniform float uTime;
     void main() {
       vA = 0.3 + 0.7 * sin(uTime * 1.5 + aOffset);
       vec4 mv = modelViewMatrix * vec4(position,1.0);
       gl_PointSize = aSize * (280.0 / -mv.z);
       gl_Position  = projectionMatrix * mv;
     }`,
    `varying float vA;
     void main() {
       vec2 uv = gl_PointCoord - 0.5;
       float d = length(uv);
       if (d > 0.5) discard;
       float a = pow(1.0 - smoothstep(0.0,0.5,d), 2.0) * vA * 0.6;
       gl_FragColor = vec4(0.6, 0.85, 1.0, a);
     }`,
    uDust,
  );
  scene.add(dust);

  // ─── Animation loop ────────────────────────────────────────────────────────
  let mouseX = 0, mouseY = 0;
  const onMouse = (e: MouseEvent) => {
    mouseX =  (e.clientX / W - 0.5) * 2;
    mouseY = -(e.clientY / H - 0.5) * 2;
  };
  window.addEventListener('mousemove', onMouse);

  const clock = new THREE.Clock();
  let frameId: number;

  function tick() {
    frameId = requestAnimationFrame(tick);
    const t = clock.getElapsedTime();

    starUniforms.uTime.value = t;
    u404.uTime.value         = t;
    uDust.uTime.value        = t;

    stars.rotation.z  = t * 0.006;
    nebula.rotation.z = t * 0.004;

    // Parallax camera
    camera.position.x += (mouseX * 4 - camera.position.x) * 0.025;
    camera.position.y += (mouseY * 2.5 - camera.position.y) * 0.025;
    camera.lookAt(0, 0, 0);

    renderer.render(scene, camera);
  }
  tick();

  // ─── Resize ────────────────────────────────────────────────────────────────
  const onResize = () => {
    W = container.clientWidth;
    H = container.clientHeight;
    camera.aspect = W / H;
    camera.updateProjectionMatrix();
    renderer.setSize(W, H);
  };
  window.addEventListener('resize', onResize);

  // ─── Cleanup ───────────────────────────────────────────────────────────────
  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(frameId);
    window.removeEventListener('mousemove', onMouse);
    window.removeEventListener('resize', onResize);
    renderer.dispose();
  }, { once: true });
</script>
