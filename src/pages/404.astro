---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Darío Cabascango" description="This page doesn't exist.">
  <main id="main" class="not-found">
    <div class="container">
      <h1>Page not found</h1>
      <p>The page you’re looking for doesn’t exist or was moved.</p>
      <a class="button button--primary" href="/">Back to home</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  h1 {
    font-size: var(--step-display);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  p {
    margin-top: 1.25rem;
    font-size: var(--step-1);
    color: var(--muted);
  }

  a {
    margin-top: 2rem;
  }
</style>
