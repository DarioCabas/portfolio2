---
import ChipList from '@/components/ui/ChipList.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import projects from '@/data/projects';
---

<section class="section" aria-labelledby="other-projects-heading">
  <div class="container">
    <div class="op-header" data-reveal>
      <h2 class="section-heading" id="other-projects-heading">Other projects</h2>
      <ExternalLink class="op-archive" href="https://github.com/DarioCabas">Full archive on GitHub</ExternalLink>
    </div>

    <ul class="op-list">
      {projects.map((project, index) => (
        <li class="op-row" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <h3 class="op-title">
            <ExternalLink href={project.external || project.github}>{project.title}</ExternalLink>
          </h3>
          <p class="op-desc">{project.description}</p>
          <ChipList items={project.techs} label={`${project.title} technologies`} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .op-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 2rem;
  }

  .op-header :global(.op-archive) {
    font-weight: 600;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .op-row {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 4fr);
    gap: 0.75rem 2rem;
    align-items: start;
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .op-row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .op-title {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  .op-title :global(a) {
    text-decoration-color: transparent;
  }

  .op-title :global(a:hover) {
    text-decoration-color: var(--marigold);
  }

  .op-desc {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .op-row {
      grid-template-columns: 1fr;
    }
  }
</style>
