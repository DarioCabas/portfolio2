---
import ChipList from '@/components/ui/ChipList.astro';
import skillGroups from '@/data/skills';
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="container">
    <h2 class="section-heading" id="about-heading" data-reveal>About me</h2>
  </div>

  <div class="about container">
    <div class="about-text" data-reveal>
      <p>
        Hello! I’m Darío. For 6+ years I’ve built reliable applications for
        web and mobile.
      </p>
      <p>
        My goal is to build products and fast experiences that people
        enjoy using. I care about clean architecture, accessibility and code
        that stays maintainable long-term.
      </p>
      <p>
        I work AI-native: agents, skills and MCP servers are part of my daily
        workflow, from the spec to the code review.
      </p>
    </div>

    <div class="about-skills" data-reveal style="--reveal-delay: 120ms">
      <h3>Tech stack</h3>
      <dl>
        {skillGroups.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd><ChipList items={group.items} label={group.label} /></dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .about-text {
    max-width: var(--measure);
  }

  .about-text p {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .about-text p + p {
    margin-top: 1em;
    color: var(--muted);
  }

  .about-skills h3 {
    font-size: var(--step-1);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .about-skills dl > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--rule);
  }

  .about-skills dt {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 400px) {
    .about-skills dl > div {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
