---
import HeroTerrain from '@/components/islands/HeroTerrain.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { email, profileFacts } from '@/data/config';
---

<section class="hero" aria-labelledby="hero-name">

  <div class="hero-grid container">
    <div class="hero-text">
      <h1 class="hero-name" id="hero-name">
        <span class="hero-line"><span>Darío</span></span>
        <span class="hero-line"><span>Cabascango</span></span>
      </h1>

      <p class="hero-role hero-step" style="--step: 1">UX Engineer and AI-native developer</p>

      <p class="hero-intro hero-step" style="--step: 2">
        I build web and mobile applications with scalable architecture and
        great user experiences, shipped faster with AI agents.
      </p>

      <div class="hero-actions hero-step" style="--step: 3">
        <a class="button button--primary" href={`mailto:${email}`}>Email me</a>
        <SocialLinks />
      </div>
    </div>

    <img
      class="hero-photo hero-step"
      style="--step: 1"
      src="/avatar.png"
      alt="Portrait of Darío Cabascango"
      width="360"
      height="480"
      fetchpriority="high"
      decoding="async"
    />

    <dl class="hero-facts hero-step" style="--step: 4">
      {profileFacts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <HeroTerrain />
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 8vh, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }

  .hero-name {
    font-size: clamp(3.5rem, 19vw, 9.5rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  /* Load sequence: name lines rise out of their masks, then the rest follows */
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero-line > span {
    display: block;
    animation: rise 0.9s var(--ease-out) both;
  }

  .hero-line:nth-child(2) > span {
    animation-delay: 0.08s;
  }

  .hero-step {
    animation: fade-up 0.8s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--step) * 0.1s);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .hero-role {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    font-size: var(--step-2);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .hero-intro {
    max-width: 46ch;
    margin-top: 1.25rem;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .hero-facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .hero-facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .hero-facts dd {
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    /* On small screens the portrait becomes a compact avatar above the name */
    .hero-photo {
      order: -1;
      width: 5.5rem;
      aspect-ratio: 1;
      object-position: top;
      border-radius: 50%;
    }

    .hero-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Primary action takes the full row; secondary ones share the next */
  @media (max-width: 480px) {
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .hero-actions :global(.button) {
      justify-content: center;
    }

    .hero-actions .button--primary {
      grid-column: 1 / -1;
    }
  }
</style>
