---
import { email } from '@/data/config';

const [emailUser, emailDomain] = email.split('@');
---

<section id="contact" class="contact" aria-labelledby="contact-heading">
  <div class="contact-panel container" data-reveal>
    <h2 class="contact-heading" id="contact-heading">Let’s talk</h2>
    <p class="contact-body">Have a project or a role in mind? Send me an email.</p>

    {/* aria-label keeps the address in one piece for screen readers; <wbr> only helps visual wrapping */}
    <a class="contact-email" href={`mailto:${email}`} aria-label={`Email ${email}`}>{emailUser}@<wbr />{emailDomain}</a>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-space);
    background: var(--surface);
  }

  .contact-heading {
    font-size: var(--step-display);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .contact-body {
    margin-top: 1.25rem;
    font-size: var(--step-1);
    color: var(--muted);
  }

  .contact-email {
    display: inline-block;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    font-size: clamp(1.25rem, 5.4vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--marigold);
    text-decoration-color: color-mix(in srgb, var(--marigold) 45%, transparent);
    text-decoration-thickness: 2px;
  }

  .contact-email:hover {
    text-decoration-color: var(--marigold);
    text-decoration-thickness: 4px;
  }
</style>
