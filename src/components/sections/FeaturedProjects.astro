---
import ChipList from '@/components/ui/ChipList.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import External from '@/components/icons/External.astro';
import featuredProjects from '@/data/featured-projects';

const headingId = (title: string) => `fp-${title.toLowerCase().replace(/\W+/g, '-')}`;
---

<section id="projects" class="section" aria-labelledby="featured-heading">
  <div class="container">
    <h2 class="section-heading" id="featured-heading" data-reveal>Selected work</h2>

    <div class="fp-list">
      {featuredProjects.map((project) => (
        <article class="fp" data-reveal aria-labelledby={headingId(project.title)}>
          <div class="fp-cover-frame">
            <img
              class="fp-cover"
              src={project.cover}
              alt={`${project.title} screenshot`}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="fp-body">
            <h3 class="fp-title" id={headingId(project.title)}>{project.title}</h3>
            <p class="fp-desc">{project.description}</p>
            <ChipList items={project.techs} label={`${project.title} technologies`} />
            {project.external && (
              <ExternalLink class="fp-link" href={project.external}>
                Visit {project.title}
                <External class="fp-link-icon" />
              </ExternalLink>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .fp-list {
    display: grid;
    gap: clamp(3.5rem, 8vw, 6rem);
  }

  .fp {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .fp-cover-frame {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .fp-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s var(--ease-out);
  }

  .fp:hover .fp-cover {
    transform: scale(1.03);
  }

  .fp-title {
    font-size: var(--step-2);
    margin-bottom: 0.75rem;
  }

  .fp-desc {
    max-width: 44ch;
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .fp-body :global(.fp-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding-block: 0.25rem;
    font-weight: 600;
  }

  .fp :global(.fp-link-icon) {
    width: 1em;
    height: 1em;
    transition: transform 0.25s var(--ease-out);
  }

  .fp :global(.fp-link:hover .fp-link-icon) {
    transform: translate(2px, -2px);
  }

  @media (max-width: 760px) {
    .fp {
      grid-template-columns: 1fr;
    }
  }
</style>
