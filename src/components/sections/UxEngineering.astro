---
import { uxLead, uxPillars } from '@/data/ux-engineering';
---

<section id="ux" class="section" aria-labelledby="ux-heading">
  <div class="container">
    <h2 class="section-heading" id="ux-heading" data-reveal>UX engineering</h2>
    <p class="ux-lead" data-reveal style="--reveal-delay: 80ms">{uxLead}</p>

    <ul class="ux-grid">
      {uxPillars.map((pillar, index) => (
        <li class="ux-pillar" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
          <h3>{pillar.title}</h3>
          <p>{pillar.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ux-lead {
    max-width: 36ch;
    margin-top: -1rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    font-size: var(--step-2);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .ux-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .ux-pillar {
    position: relative;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .ux-pillar:hover {
    border-color: color-mix(in srgb, var(--marigold) 55%, transparent);
  }

  .ux-pillar h3 {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }

  .ux-pillar p {
    color: var(--muted);
    max-width: 44ch;
  }

  @media (max-width: 560px) {
    .ux-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
