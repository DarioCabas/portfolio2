---
import { aiConceptGroups } from '@/data/ai-concepts';

const [firstGroup] = aiConceptGroups;
const [firstConcept] = firstGroup.concepts;
let chipIndex = 0;
---

<div class="concepts" data-concepts data-reveal>
  <div class="concepts-groups">
    {aiConceptGroups.map((group) => (
      <div class="concepts-group" role="group" aria-labelledby={`concepts-${group.id}`} data-group={group.id}>
        <h4 id={`concepts-${group.id}`}>{group.label}</h4>
        <ul>
          {group.concepts.map((concept) => (
            <li style={`--n: ${chipIndex++}`}>
              <button
                class="concept-chip"
                type="button"
                aria-pressed={concept === firstConcept ? 'true' : 'false'}
                data-concept={concept.name}
                data-group-label={group.label}
                data-group-id={group.id}
                data-definition={concept.definition}
              >
                {concept.name}
              </button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  {/* Announced politely whenever a concept is selected */}
  <div class="concepts-panel" aria-live="polite" data-concepts-panel>
    <p class="concepts-panel-group" data-panel-group>{firstGroup.label}</p>
    <p class="concepts-panel-name" data-panel-name>{firstConcept.name}</p>
    <p class="concepts-panel-definition" data-panel-definition>{firstConcept.definition}</p>
    <p class="concepts-panel-hint" aria-hidden="true">Select a concept to see what it means.</p>
  </div>

  <noscript>
    <dl class="concepts-glossary">
      {aiConceptGroups.flatMap((group) => group.concepts).map((concept) => (
        <div>
          <dt>{concept.name}</dt>
          <dd>{concept.definition}</dd>
        </div>
      ))}
    </dl>
  </noscript>
</div>

<style>
  .concepts {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .concepts-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
  }

  .concepts-group h4 {
    margin-bottom: 0.75rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
    transition: color 0.25s var(--ease-out);
  }

  .concepts-group.is-current h4 {
    color: var(--marigold);
  }

  .concepts-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .concept-chip {
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .concept-chip:hover {
    border-color: var(--lilac);
    transform: translateY(-1px);
  }

  .concept-chip[aria-pressed='true'] {
    border-color: var(--marigold);
    background: var(--marigold);
    color: var(--night);
    font-weight: 600;
  }

  /* Chips cascade in once the map scrolls into view */
  :global(.js) .concepts .concepts-group li {
    opacity: 0;
    transform: translateY(8px);
  }

  :global(.js) .concepts.is-visible .concepts-group li {
    animation: chip-in 0.5s var(--ease-out) calc(150ms + var(--n) * 28ms) both;
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Centered beside the groups on wide screens; still sticks while scrolling */
  .concepts-panel {
    align-self: center;
    position: sticky;
    top: calc(var(--nav-height) + 1rem);
    min-height: 12rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .concepts-panel-group {
    font-size: var(--step--1);
    color: var(--marigold);
    font-weight: 600;
  }

  .concepts-panel-name {
    margin-top: 0.25rem;
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .concepts-panel-definition {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .concepts-panel-hint {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .concepts-panel.is-changing > * {
    animation: panel-in 0.35s var(--ease-out) both;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .concepts-glossary {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
  }

  .concepts-glossary dt {
    font-weight: 600;
  }

  .concepts-glossary dd {
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .concepts {
      grid-template-columns: 1fr;
    }

    /* On narrow screens the definition stays pinned above the chips */
    .concepts-panel {
      align-self: start;
      order: -1;
      z-index: 2;
      min-height: 0;
      padding: 1rem 1.25rem;
      box-shadow: 0 12px 24px -12px rgb(0 0 0 / 0.6);
    }

    .concepts-panel-hint {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .concepts-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .concepts-groups {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .concepts .concepts-group li,
    :global(.js) .concepts.is-visible .concepts-group li {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (forced-colors: active) {
    .concept-chip {
      border-color: ButtonText;
    }

    .concept-chip[aria-pressed='true'] {
      background: Highlight;
      color: HighlightText;
    }
  }
</style>

<script>
  function initConcepts() {
    document.querySelectorAll<HTMLElement>('[data-concepts]').forEach((root) => {
      const chips = root.querySelectorAll<HTMLButtonElement>('.concept-chip');
      const panel = root.querySelector<HTMLElement>('[data-concepts-panel]');
      if (!panel) return;
      const groupText = panel.querySelector('[data-panel-group]')!;
      const nameText = panel.querySelector('[data-panel-name]')!;
      const definitionText = panel.querySelector('[data-panel-definition]')!;

      const select = (chip: HTMLButtonElement) => {
        if (chip.getAttribute('aria-pressed') === 'true') return;
        chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
        root.querySelectorAll('[data-group]').forEach((group) => {
          group.classList.toggle('is-current', group.getAttribute('data-group') === chip.dataset.groupId);
        });
        groupText.textContent = chip.dataset.groupLabel ?? '';
        nameText.textContent = chip.dataset.concept ?? '';
        definitionText.textContent = chip.dataset.definition ?? '';
        panel.classList.remove('is-changing');
        void panel.offsetWidth; // restart the fade
        panel.classList.add('is-changing');
      };

      chips.forEach((chip) => {
        chip.addEventListener('click', () => select(chip));
        // Mouse users get a preview on hover; touch and keyboard select explicitly
        chip.addEventListener('pointerenter', (event) => {
          if (event.pointerType === 'mouse') select(chip);
        });
      });

      root.querySelector(`[data-group="${chips[0]?.dataset.groupId}"]`)?.classList.add('is-current');
    });
  }

  document.addEventListener('astro:page-load', initConcepts);
</script>
