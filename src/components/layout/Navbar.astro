---
import { navLinks } from '@/data/config';
import Logo from '@/components/icons/Logo.astro';
---

<header class="navbar" data-navbar>
  <div class="navbar-inner container">
    <a href="/" class="navbar-logo" aria-label="Darío Cabascango — Home">
      <Logo width={36} height={36} />
    </a>

    <nav aria-label="Main navigation">
      <ul class="navbar-links">
        {navLinks.map((link) => (
          <li>
            <a href={link.url} data-nav-link>{link.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }

  /* Solid bar only once content scrolls underneath it */
  .navbar.is-scrolled {
    background: color-mix(in srgb, var(--night) 88%, transparent);
    backdrop-filter: blur(12px);
    border-color: var(--rule);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--nav-height);
  }

  .navbar-logo {
    flex-shrink: 0;
    color: var(--text);
    transition: color 0.2s var(--ease-out);
  }

  .navbar-logo:hover {
    color: var(--marigold);
  }

  .navbar-links {
    display: flex;
    gap: clamp(0.85rem, 3vw, 2.25rem);
    font-size: 1rem;
    font-weight: 500;
  }

  .navbar-links a {
    position: relative;
    display: inline-block;
    min-width: 24px;
    text-align: center;
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.4rem;
  }

  .navbar-links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--marigold);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .navbar-links a:hover,
  .navbar-links a[aria-current] {
    color: var(--text);
  }

  .navbar-links a:hover::after,
  .navbar-links a[aria-current]::after {
    transform: scaleX(1);
  }
  /* Short viewports (landscape phones, 200% zoom) need the space more than a sticky bar */
  @media (max-height: 500px) {
    .navbar {
      position: static;
    }
  }

  @media (max-width: 360px) {
    .navbar-links {
      font-size: 0.9375rem;
    }
  }
</style>
