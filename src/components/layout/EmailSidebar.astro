---
import { email } from '@/data/config';
---

<aside class="sidebar sidebar--right" id="email-sidebar" aria-label="Email contact">
  <a href={`mailto:${email}`} class="sidebar-email">{email}</a>
</aside>

<script>
  window.addEventListener('loader:done', () => {
    const sidebar = document.getElementById('email-sidebar');
    if (sidebar) {
      setTimeout(() => sidebar.classList.add('visible'), 400);
    }
  });
</script>
