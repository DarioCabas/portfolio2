---
import { socialLinks } from '@/data/config';
import GitHub from '@/components/icons/GitHub.astro';
import LinkedIn from '@/components/icons/LinkedIn.astro';
import Instagram from '@/components/icons/Instagram.astro';
import Twitter from '@/components/icons/Twitter.astro';

const year = new Date().getFullYear();
---

<footer>
  <!-- Mobile social links (hidden on desktop where sidebar shows) -->
  <ul class="footer-links" aria-label="Social media links">
    {socialLinks.filter(l => l.url).map((link) => (
      <li>
        <a href={link.url} aria-label={link.name} target="_blank" rel="noreferrer noopener">
          {link.name === 'GitHub' && <GitHub class="sidebar-icon" />}
          {link.name === 'LinkedIn' && <LinkedIn class="sidebar-icon" />}
          {link.name === 'Instagram' && <Instagram class="sidebar-icon" />}
          {link.name === 'Twitter' && <Twitter class="sidebar-icon" />}
        </a>
      </li>
    ))}
  </ul>

  <p class="footer-credit">
    Designed & Built by <a href="https://github.com/DarioCabas" target="_blank" rel="noreferrer">Darío Cabascango</a>
    <br />
    Built with <a href="https://astro.build" target="_blank" rel="noreferrer">Astro 5</a> · {year}
  </p>
</footer>
