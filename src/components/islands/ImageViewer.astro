<script>
  function initImageViewer() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function openViewer(src: string, alt: string, triggerImg?: HTMLImageElement) {
      const existing = document.getElementById('image-viewer');
      if (existing) existing.remove();

      const overlay = document.createElement('div');
      overlay.id = 'image-viewer';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', `${alt} fullscreen view`);

      const img = document.createElement('img');
      img.src = src;
      img.alt = alt;

      const closeBtn = document.createElement('button');
      closeBtn.className = 'close-btn';
      closeBtn.setAttribute('aria-label', 'Close image viewer');
      closeBtn.textContent = '×';

      overlay.appendChild(img);
      overlay.appendChild(closeBtn);
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';
      closeBtn.focus();

      function close() {
        document.body.style.overflow = '';
        overlay.style.opacity = '0';
        overlay.addEventListener('transitionend', () => overlay.remove(), { once: true });
        overlay.style.transition = 'opacity 0.2s ease';
      }

      closeBtn.addEventListener('click', close);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) close();
      });
      document.addEventListener('keydown', function onKey(e) {
        if (e.key === 'Escape') {
          close();
          document.removeEventListener('keydown', onKey);
        }
      });
    }

    // Delegate click events for all viewer triggers
    document.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-viewer-src]');
      if (!btn) return;

      const src = btn.dataset.viewerSrc!;
      const alt = btn.dataset.viewerAlt ?? '';
      const triggerImg = btn.querySelector<HTMLImageElement>('img') ?? undefined;

      if (!prefersReducedMotion && 'startViewTransition' in document && triggerImg) {
        (document as any).startViewTransition(() => openViewer(src, alt, triggerImg));
      } else {
        openViewer(src, alt, triggerImg);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageViewer);
  } else {
    initImageViewer();
  }
</script>
