---
import { email } from '@/data/config';
---

<div id="qr-widget" aria-label="QR code contact widget">
  <div id="qr-popup" class="qr-popup" aria-live="polite">
    <canvas id="qr-canvas" width="140" height="140" aria-label={`QR code linking to ${email}`}></canvas>
    <p>Scan to email me</p>
  </div>
  <button class="qr-toggle-btn" id="qr-toggle" aria-label="Toggle QR code" aria-expanded="false" aria-controls="qr-popup">
    ⊞
  </button>
</div>

<script define:vars={{ emailAddr: email }}>
  async function initQrWidget() {
    const toggle = document.getElementById('qr-toggle');
    const popup = document.getElementById('qr-popup');
    const canvas = document.getElementById('qr-canvas');
    if (!toggle || !popup || !canvas) return;

    // Dynamically import qrcode to keep it out of the main bundle
    const QRCode = (await import('qrcode')).default;
    await QRCode.toCanvas(canvas, `mailto:${emailAddr}`, {
      width: 140,
      color: { dark: '#e8e6f0', light: '#14112b' },
    });

    toggle.addEventListener('click', () => {
      const isOpen = popup.classList.toggle('visible');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!document.getElementById('qr-widget')?.contains(/** @type {Node} */ (e.target))) {
        popup.classList.remove('visible');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Init lazily after page is interactive
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => initQrWidget());
  } else {
    setTimeout(initQrWidget, 2000);
  }
</script>
