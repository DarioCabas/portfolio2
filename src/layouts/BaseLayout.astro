---
import { ClientRouter } from 'astro:transitions';
import CursorGlow from '@/components/islands/CursorGlow.astro';
import ScrollEffects from '@/components/islands/ScrollEffects.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Darío Cabascango — Software Developer",
  description = "UX engineer and AI-native developer in Quito, Ecuador. Web and mobile products, design systems and AI agent workflows."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Darío Cabascango" />
    <meta name="theme-color" content="#14172b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />

    <!-- Hide reveal targets before first paint so they don't flash in and out -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>
    <slot />
    <ScrollEffects />
    <CursorGlow />
  </body>
</html>
